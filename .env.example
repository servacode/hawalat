# ---- نسخة مثال — انسخها إلى .env وعدّل القيم ----
# cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database (PostgreSQL)
# ملاحظة: POSTGRES_HOST يضبطه docker-compose تلقائياً (db).
# اتركه فارغاً هنا ليعمل التطوير المحلي بلا Docker على sqlite تلقائياً.
POSTGRES_DB=hawalat
POSTGRES_USER=hawalat
POSTGRES_PASSWORD=hawalat-dev-password
POSTGRES_PORT=5432

# Redis (channels + celery)
REDIS_URL=redis://redis:6379/0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
